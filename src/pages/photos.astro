---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoCard from "../components/PhotoCard.astro";
import { photos } from "../data/photos";
---

<BaseLayout title="Photos" description="Some of my favorite pics">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="font-mono text-sm font-medium text-primary">Elsewhere</p>
    <h1 class="mt-3 max-w-2xl">Photos</h1>
    <p class="measure mt-4 text-lg text-foreground-muted">
      Because sometimes Instagram isn't enough.
    </p>

    {
      photos.every((photo) => photo.isPlaceholder) && (
        <div class="measure mt-6 rounded-md border border-warning/40 bg-amber-50 px-5 py-4 text-sm text-amber-900 dark:bg-amber-950/20 dark:text-amber-200">
          <strong>Every card below is a placeholder.</strong> I'll get around to this eventually...
        </div>
      )
    }

    <div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-14 sm:grid-cols-3 lg:grid-cols-4">
      {photos.map((photo, index) => <PhotoCard photo={photo} index={index} />)}
    </div>
  </div>
</BaseLayout>

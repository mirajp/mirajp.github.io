---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Paint from "../../components/tools/Paint";

const title = 'Paint Studio';
const description = 'Paste a picture and mark it up. An in-browser Paint-like tool.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <a href="/tools/" class="text-sm text-foreground-muted hover:text-foreground">&larr; All tools</a>
    <p class="mt-6 font-mono text-sm font-medium text-primary">Tools</p>

    <h1 class="mt-2">Paint Studio</h1>

    <Paint client:load />
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiffViewer from "../../components/tools/DiffViewer";

const title = 'Diff Viewer';
const description = 'Compare two blocks of text or code side by side or as a unified diff.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <a href="/tools/" class="text-sm text-foreground-muted hover:text-foreground">&larr; All tools</a>
    <p class="mt-6 font-mono text-sm font-medium text-primary">Tools</p>

    <h1 class="mt-2">Diff Viewer</h1>
    <p class="mt-3 text-foreground-muted">
      Paste two versions of some text or code to see exactly what changed. Everything runs in your browser, nothing
      is uploaded anywhere.
    </p>

    <DiffViewer client:load />
  </div>
</BaseLayout>

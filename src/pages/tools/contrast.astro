---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContrastChecker from "../../components/tools/ContrastChecker";
---

<BaseLayout title="Contrast Checker" description="A WCAG contrast ratio checker, live in the browser.">
  <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
    <a href="/tools/" class="text-sm text-foreground-muted hover:text-foreground">&larr; All tools</a>
    <p class="mt-6 font-mono text-sm font-medium text-primary">Tools</p>
    <h1 class="mt-2">Contrast Checker</h1>
    <p class="mt-3 text-foreground-muted">
      The same WCAG math this site's own palette was checked against — pick two colors and see where they
      land against AA and AAA.
    </p>

    <div class="mt-10">
      <ContrastChecker client:load />
    </div>
  </div>
</BaseLayout>

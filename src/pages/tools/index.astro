---
import BaseLayout from "../../layouts/BaseLayout.astro";

const tools = [
  {
    href: "/tools/pomodoro/",
    title: "Pomodoro Timer",
    description: "A focus timer with configurable work/break lengths, a progress bar, and an optional browser notification when a session ends.",
  },
  {
    href: "/tools/scratchpad/",
    title: "Markdown Scratchpad",
    description: "A two-pane Markdown editor with a live preview. Autosaves to this browser as you type — nothing is sent anywhere.",
  },
  {
    href: "/tools/contrast/",
    title: "Contrast Checker",
    description: "Live WCAG AA/AAA contrast checking for any two colors — the same math this site's own palette was checked against.",
  },
];
---

<BaseLayout title="Tools" description="Small, client-side productivity tools hosted on this site.">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="font-mono text-sm font-medium text-primary">Tools</p>
    <h1 class="mt-3 max-w-3xl">Misc tools</h1>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <a
            href={tool.href}
            class="group rounded-lg border border-border bg-surface p-6 transition-shadow duration-150 hover:shadow-md"
          >
            <h2 class="!text-xl !font-semibold text-foreground group-hover:text-primary">{tool.title}</h2>
            <p class="mt-2 text-[15px] leading-relaxed text-foreground-muted">{tool.description}</p>
            <span class="mt-4 inline-block text-sm font-medium text-primary">Open tool &rarr;</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

---
import { getCollection } from "astro:content";

import BlogCard from "../components/BlogCard.astro";
import Button from "../components/Button.astro";
import Metrics from "../components/Metrics.astro";
import NowCard from "../components/NowCard.astro";
import NycHero from "../components/NycHero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { experience, headlineMetrics } from "../data/experience";
import { projects } from "../data/projects";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getReadingTime } from "../utils/readingTime";

const featuredProjects = projects.filter((p) => p.featured);

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate)
  .slice(0, 3);

const currentRole = experience[0];

// Split the tagline so one word gets the active theme's hero emphasis
// (.squiggle: wobbly underline in Crisp Forest, [people] brackets in Swiss
// Drafting, italic stress in Press & Darkroom). Falls back to the plain string
// if the tagline copy changes later.
const squiggleWord = "people";
const [taglineBefore, taglineAfter] = site.tagline.includes(squiggleWord)
  ? site.tagline.split(squiggleWord)
  : [site.tagline, null];
---

<BaseLayout title={site.name} description={site.summary}>
  <NycHero
    eyebrow={`${currentRole.title} · ${currentRole.company}`}
    subhead={site.summary}
    primaryCta={{ label: "View Projects", href: "/projects/" }}
    secondaryCta={{ label: "Read the Blog", href: "/blog/" }}
  >
    {taglineBefore}{
      taglineAfter !== null && <span class="squiggle">{squiggleWord}</span>
    }{taglineAfter}
  </NycHero>

  <NowCard />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <Metrics metrics={headlineMetrics} />
  </section>

  <section
    class="bg-surface/50"
    style="border-top: var(--section-rule); border-bottom: var(--section-rule);"
  >
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2>Featured work</h2>
        <Button href="/projects/" variant="text">
          View all projects &rarr;
        </Button>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2>Recent writing</h2>
      <Button href="/blog/" variant="text">View all posts &rarr;</Button>
    </div>
    <div class="mt-4 divide-y divide-border-subtle">
      {
        recentPosts.map((post) => (
          <BlogCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            readingTime={getReadingTime(post.body ?? "")}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
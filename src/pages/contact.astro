---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm";
import { site } from "../data/site";
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="font-mono text-sm font-medium text-primary">Contact</p>
    <h1 class="mt-3 max-w-2xl">Let's talk</h1>
    <p class="measure mt-4 text-lg text-foreground-muted">
      The fastest way to reach me is email. The form below works too — it opens a pre-filled email in your
      own mail client.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-[1fr_360px]">
      <div class="max-w-xl">
        <ContactForm client:load />
      </div>

      <aside class="space-y-6">
        <div class="rounded-lg border border-border bg-surface p-6">
          <h2 class="!text-sm !font-semibold uppercase tracking-wide text-foreground-muted">Direct</h2>
          <ul class="mt-3 space-y-3 text-sm">
            <li>
              <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:text-primary-hover">
                LinkedIn &rarr;
              </a>
            </li>
            <li>
              <a href={site.github} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:text-primary-hover">
                GitHub &rarr;
              </a>
            </li>
          </ul>
        </div>
        <p class="text-xs leading-relaxed text-foreground-muted">
          Based in {site.location}. Open to conversations about technical leadership, design systems, and
          AI-powered product work.
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import { site } from "../data/site";
import { experience, education, skills } from "../data/experience";
---

<BaseLayout title="Resume" description={`Resume for ${site.name}, ${site.role}.`}>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="font-mono text-sm font-medium text-primary">Resume</p>
        <h1 class="mt-3">{site.name}</h1>
        <p class="mt-1 text-lg text-foreground-muted">{site.role} · {site.location}</p>
      </div>
    </div>

    <p class="mt-2 hidden text-sm text-foreground-muted print:block">
      {site.github} · {site.linkedin}
    </p>

    <section class="mt-16 max-w-3xl">
      <h2 class="!text-2xl !font-bold">Summary</h2>
      <p class="mt-4 text-[17px] leading-[1.75] text-foreground-muted">{site.summary}</p>
    </section>

    <section class="mt-16">
      <h2 class="!text-2xl !font-bold">Experience</h2>
      <div class="mt-8 max-w-3xl">
        <ExperienceTimeline entries={experience} />
      </div>
    </section>

    <section class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-2">
      <div>
        <h2 class="!text-2xl !font-bold">Education</h2>
        <ul class="mt-6 space-y-4">
          {
            education.map((entry) => (
              <li>
                <p class="font-medium text-foreground">{entry.degree}</p>
                <p class="text-sm text-foreground-muted">{entry.school} · {entry.location}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="!text-2xl !font-bold">Skills</h2>
        <dl class="mt-6 space-y-4">
          {
            skills.map((group) => (
              <div>
                <dt class="text-sm font-semibold text-foreground">{group.category}</dt>
                <dd class="mt-1 text-sm text-foreground-muted">{group.items.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </div>
</BaseLayout>

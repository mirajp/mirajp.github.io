---
import BaseLayout from "../layouts/BaseLayout.astro";
import SvgEditor from "../components/tools/svg-editor/ui/SvgEditor";

export function getStaticPaths() {
  if (process.env.SVG_EDITOR_E2E !== "1") return [];
  return ["isolation", "lifecycle"].map((name) => ({
    params: { svgEditorE2e: `__e2e/${name}` },
    props: { name },
  }));
}

const { name } = Astro.props;
---

<BaseLayout title={`SVG editor ${name} E2E`} description="Test-only SVG editor host." noIndex>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1>SVG editor E2E host</h1>
    {name === "lifecycle" && (
      <div class="mb-4 flex gap-3">
        <button id="unmount-editor" type="button">Unmount editor</button>
        <button id="remount-editor" type="button">Remount editor</button>
      </div>
    )}
    <div id="editor-host">
      <SvgEditor client:only="react">
        <div slot="fallback" aria-busy="true">Loading test editor…</div>
      </SvgEditor>
    </div>
    {name === "lifecycle" && (
      <template id="editor-template">
        <SvgEditor client:only="react">
          <div slot="fallback" aria-busy="true">Loading test editor…</div>
        </SvgEditor>
      </template>
    )}
  </div>

  <style is:global>
    body {
      color: #d00080 !important;
      font-family: monospace !important;
    }

    * {
      color: #d00080 !important;
      font-family: monospace !important;
      letter-spacing: 0.08em !important;
    }
  </style>

  {name === "lifecycle" && (
    <script is:inline>
      (() => {
        const host = document.getElementById("editor-host");
        const island = host?.querySelector("astro-island");
        const template = document.getElementById("editor-template");
        const unmount = document.getElementById("unmount-editor");
        const remount = document.getElementById("remount-editor");
        if (!host || !island || !template || !unmount || !remount) return;
        unmount.addEventListener("click", () => {
          island.remove();
          document.dispatchEvent(new Event("astro:after-swap"));
        });
        remount.addEventListener("click", () =>
          host.append(template.content.cloneNode(true)),
        );
      })();
    </script>
  )}
</BaseLayout>

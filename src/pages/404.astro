---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noIndex>
  <div class="mx-auto flex max-w-2xl flex-col items-start px-4 py-32 sm:px-6 lg:px-8">
    <p class="font-mono text-sm font-medium text-primary">404</p>
    <h1 class="mt-3">This route doesn't <span class="squiggle">exist</span>.</h1>
    <p class="mt-4 text-lg text-foreground-muted">
      Could be an old link, could be a typo, could be a page that never got built. No way to tell from here.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="/" class="inline-flex min-h-11 items-center rounded-md bg-primary px-5 text-sm font-medium text-white hover:bg-primary-hover">
        Back to homepage
      </a>
      <p class="text-sm text-foreground-muted">
        or press <kbd class="search-shortcut rounded border border-border bg-surface px-1.5 py-0.5 font-mono text-xs">⌘-K</kbd> to jump somewhere specific
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const shortcut = document.querySelector<HTMLSpanElement>(".search-shortcut");

  if (shortcut) {
    // `navigator.platform` is deprecated, so prefer `userAgentData` when
    // available, falling back to the user agent for Safari/iOS/etc.
    const isMac =
      /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      navigator.userAgentData?.platform === "macOS";

    shortcut.textContent = isMac ? "⌘-K" : "Ctrl + K";
  }
</script>

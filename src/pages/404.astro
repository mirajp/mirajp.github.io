---
import ChromeDinoSvg from "../../assets/chrome_dino_dropped_ice_cream.svg?raw"; 
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noIndex>
  <div class="mx-auto flex max-w-2xl flex-col items-start px-4 py-32 sm:px-6 lg:px-8">
    <p class="font-mono text-sm font-medium text-primary">404</p>

    <h1 class="mt-3">Uh oh, this route doesn't <span class="squiggle">exist</span>.</h1>
    <p class="mt-4 text-lg text-foreground-muted">
      Could be an old link, could be a typo, could be a page that never got built. No way to tell from here.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="/" class="inline-flex min-h-11 items-center rounded-md bg-primary px-5 text-sm font-medium text-white hover:bg-primary-hover">
        Back to homepage
      </a>
      <p class="text-sm text-foreground-muted">
        or press <kbd class="search-shortcut rounded border border-border bg-surface px-1.5 py-0.5 font-mono text-xs">⌘-K</kbd> to jump somewhere specific
      </p>
    </div>

    <div class="mb-8 flex w-full justify-center">
      <div class="h-[250px] w-[400px] flex items-center justify-center text-primary [&>svg]:h-full [&>svg]:w-full [&>svg]:object-contain">
        <Fragment set:html={ChromeDinoSvg} />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const shortcut = document.querySelector<HTMLSpanElement>(".search-shortcut");

  if (shortcut) {
    // `navigator.platform` is deprecated, so prefer `userAgentData` when
    // available, falling back to the user agent for Safari/iOS/etc.
    const isMac =
      /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      navigator.userAgentData?.platform === "macOS";

    shortcut.textContent = isMac ? "⌘-K" : "Ctrl + K";
  }

  function updateBackground() {
    // Get the element holding your data-theme (usually document.documentElement which is <html>)
    const root = document.documentElement;
    const theme = root.getAttribute('data-theme');

    if (theme !== 'dark') {
      // Set the CSS variable inline to override any CSS files
      root.style.setProperty('--background', '#ffffff');
    } else {
      // Optional: Remove the inline style override when switching back to dark
      root.style.removeProperty('--background');
    }
  }

  // 1. Run immediately when the page loads or transitions
  updateBackground();

  // 2. Watch for theme toggles dynamically while the user is on the page
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'data-theme') {
        updateBackground();
      }
    });
  });

  observer.observe(document.documentElement, { attributes: true });
</script>

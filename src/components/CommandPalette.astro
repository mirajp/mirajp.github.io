---
// Vanilla JS, not a React island — this renders on every page via
// BaseLayout, so keeping it framework-free means pages with no other
// interactive component (About, Projects, Photos...) still ship zero
// component JS. Uses the native <dialog> for free focus containment,
// Escape-to-close, and backdrop behavior instead of hand-rolled a11y.
import { nav } from "../data/site";

const destinations = [
  ...nav,
  { label: "Colophon", href: "/colophon/" },
];
---

<button
  id="cmdk-trigger"
  type="button"
  aria-haspopup="dialog"
  class="hidden items-center gap-2 rounded-md border border-border px-3 py-2 text-xs text-foreground-muted hover:bg-surface-hover hover:text-foreground sm:inline-flex"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span>Search</span>
  <kbd class="search-shortcut rounded border border-border bg-surface px-1.5 py-0.5 font-mono text-[10px]">⌘-K</kbd>
</button>

<dialog
  id="cmdk-dialog"
  aria-label="Quick navigation"
  class="m-0 w-full max-w-lg rounded-lg border border-border bg-background p-0 text-foreground backdrop:bg-gray-950/50 open:fixed open:left-1/2 open:top-24 open:-translate-x-1/2"
>
  <div class="flex items-center gap-2 border-b border-border px-4 py-3">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-foreground-muted">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      id="cmdk-input"
      type="text"
      placeholder="Jump to a page…"
      autocomplete="off"
      class="w-full bg-transparent text-sm text-foreground outline-none placeholder:text-foreground-muted"
    />
    <kbd class="shrink-0 rounded border border-border px-1.5 py-0.5 font-mono text-[10px] text-foreground-muted">esc</kbd>
  </div>
  <ul id="cmdk-results" role="listbox" class="max-h-80 overflow-y-auto p-2">
    {
      destinations.map((item, i) => (
        <li>
          <a
            href={item.href}
            data-cmdk-item
            data-index={i}
            role="option"
            class="flex items-center justify-between rounded-md px-3 py-2.5 text-sm text-foreground data-[active=true]:bg-surface-hover"
          >
            {item.label}
            <span class="font-mono text-xs text-foreground-muted">{item.href}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p id="cmdk-empty" hidden class="px-4 py-6 text-center text-sm text-foreground-muted">
    No pages match.
  </p>
</dialog>

<script>
  const shortcut = document.querySelector<HTMLSpanElement>(".search-shortcut");

  if (shortcut) {
    // `navigator.platform` is deprecated, so prefer `userAgentData` when
    // available, falling back to the user agent for Safari/iOS/etc.
    const isMac =
      /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      navigator.userAgentData?.platform === "macOS";

    shortcut.textContent = isMac ? "⌘-K" : "Ctrl + K";
  }
</script>

<script is:inline>
  (function () {
    var trigger = document.getElementById("cmdk-trigger");
    var dialog = document.getElementById("cmdk-dialog");
    var input = document.getElementById("cmdk-input");
    var list = document.getElementById("cmdk-results");
    var empty = document.getElementById("cmdk-empty");
    if (!trigger || !dialog || !input || !list) return;

     const shortcut = document.querySelector<HTMLSpanElement>("#search-shortcut");
    if (shortcut) {
      // `navigator.platform` is deprecated, so prefer `userAgentData` when
      // available, falling back to the user agent for Safari/iOS/etc.
      const isMac =
        /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
        navigator.userAgentData?.platform === "macOS";

      shortcut.textContent = isMac ? "⌘-K" : "Ctrl + K";
    }

    var items = Array.prototype.slice.call(list.querySelectorAll("[data-cmdk-item]"));
    var activeIndex = 0;

    function setActive(index) {
      var visible = items.filter(function (el) {
        return el.parentElement.style.display !== "none";
      });
      if (visible.length === 0) return;
      activeIndex = ((index % visible.length) + visible.length) % visible.length;
      items.forEach(function (el) {
        el.removeAttribute("data-active");
      });
      visible[activeIndex].setAttribute("data-active", "true");
      visible[activeIndex].scrollIntoView({ block: "nearest" });
    }

    function openPalette() {
      dialog.showModal();
      input.value = "";
      items.forEach(function (el) {
        el.parentElement.style.display = "";
      });
      empty.hidden = true;
      activeIndex = 0;
      setActive(0);
      window.setTimeout(function () {
        input.focus();
      }, 0);
    }

    trigger.addEventListener("click", openPalette);

    document.addEventListener("keydown", function (e) {
      var isK = e.key === "k" || e.key === "K";
      if ((e.metaKey || e.ctrlKey) && isK) {
        e.preventDefault();
        if (dialog.open) {
          dialog.close();
        } else {
          openPalette();
        }
      }
    });

    input.addEventListener("input", function () {
      var query = input.value.trim().toLowerCase();
      var visibleCount = 0;
      items.forEach(function (el) {
        var label = el.textContent.toLowerCase();
        var match = label.indexOf(query) !== -1;
        el.parentElement.style.display = match ? "" : "none";
        if (match) visibleCount++;
      });
      empty.hidden = visibleCount !== 0;
      activeIndex = 0;
      setActive(0);
    });

    input.addEventListener("keydown", function (e) {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(activeIndex + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(activeIndex - 1);
      } else if (e.key === "Enter") {
        var visible = items.filter(function (el) {
          return el.parentElement.style.display !== "none";
        });
        if (visible[activeIndex]) window.location.href = visible[activeIndex].getAttribute("href");
      }
    });

    dialog.addEventListener("click", function (e) {
      if (e.target === dialog) dialog.close();
    });
  })();
</script>

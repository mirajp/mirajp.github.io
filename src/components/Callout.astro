---
interface Props {
  type?: "note" | "tip" | "warning";
}

const { type = "note" } = Astro.props;

const labels: Record<string, string> = {
  note: "Note",
  tip: "Tip",
  warning: "Warning",
};

const styles: Record<string, string> = {
  note: "border-primary/40 bg-teal-50 dark:bg-teal-900/20",
  tip: "border-success/40 bg-green-50 dark:bg-green-950/20",
  warning: "border-warning/40 bg-amber-50 dark:bg-amber-950/20",
};
---

<aside class={`my-6 rounded-md border-l-4 px-5 py-4 text-[15px] leading-relaxed ${styles[type]}`}>
  <p class="mb-1 font-semibold text-foreground">{labels[type]}</p>
  <div class="text-foreground-muted [&>p]:m-0">
    <slot />
  </div>
</aside>

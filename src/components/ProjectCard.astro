---
import type { Project } from "../data/projects";
import Tag from "./Tag.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="flex h-full flex-col rounded-lg border border-border bg-surface p-6 shadow-sm transition-shadow duration-150 hover:shadow-md">
  <p class="text-xs font-medium uppercase tracking-wide text-foreground-muted">{project.org}</p>
  <h3 class="mt-1 !text-xl !font-semibold !leading-snug text-foreground">{project.title}</h3>
  <p class="mt-3 flex-1 text-[15px] leading-relaxed text-foreground-muted">{project.description}</p>

  <p class="mt-4 text-sm font-medium text-foreground">{project.impact}</p>

  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies used">
    {project.tech.map((tech) => <li><Tag label={tech} /></li>)}
  </ul>
</article>

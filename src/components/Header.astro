---
import { site, nav } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";
import CommandPalette from "./CommandPalette.astro";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="rounded-sm font-mono text-lg font-semibold tracking-tight text-foreground"
    >
      {site.name}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={`rounded-sm px-2.5 py-2 text-sm font-medium transition-colors duration-150 ${
              isActive(item.href)
                ? "text-primary"
                : "text-foreground-muted hover:text-foreground"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <CommandPalette />
      <ThemeToggle />
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md text-foreground-muted hover:bg-surface-hover hover:text-foreground lg:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile"
    aria-hidden="true"
    class="opacity-0 invisible absolute inset-x-0 top-full translate-y-[-8px] border-t border-border bg-background px-4 pb-4 shadow-lg transition-[opacity,transform,visibility] duration-250 ease-out lg:hidden"
  >
    <div class="mobile-menu-items">
      {
        nav.map((item, index) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={`mobile-menu-item block rounded-sm px-2 py-3 text-base font-medium ${
              isActive(item.href) ? "text-primary" : "text-foreground-muted"
            }`}
            style={`--menu-index: ${index}`}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("mobile-menu-button");
    var menu = document.getElementById("mobile-menu");

    if (!btn || !menu) return;

    function setOpen(open) {
      menu.dataset.open = String(open);
      menu.classList.toggle('opacity-0');
      menu.classList.toggle('invisible');
      menu.setAttribute("aria-hidden", String(!open));

      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute(
        "aria-label",
        open ? "Close menu" : "Open menu"
      );
    }

    btn.addEventListener("click", function () {
      var isOpen = menu.dataset.open === "true";
      setOpen(!isOpen);
    });

    document.addEventListener("click", function (e) {
      if (menu.dataset.open !== "true") return;

      if (!menu.contains(e.target) && !btn.contains(e.target)) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && menu.dataset.open === "true") {
        setOpen(false);
        btn.focus();
      }
    });
  })();
</script>

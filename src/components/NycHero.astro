---
import Button from "./Button.astro";
import NycBackground from "./NycBackground";
import type { SeasonTheme } from "./NycBackground/types";

interface Cta {
  label: string;
  href: string;
  disabled?: boolean;
}

interface Props {
  eyebrow: string;
  subhead: string;
  primaryCta: Cta;
  secondaryCta: Cta;
  season?: SeasonTheme;
}

const { eyebrow, subhead, primaryCta, secondaryCta, season = "auto" } = Astro.props;
---

<section class="relative border-b border-border overflow-hidden bg-background">
  <!-- React Island: Seasonal Animated SVG Line Drawings -->
  <div id="nyc-hero-bg-layer" class="pointer-events-none absolute inset-0">
    <NycBackground client:only="react" season={season} />
  </div>

  <!-- Content Layer (pointer-events-none on layout wrapper so skyline easter eggs remain clickable) -->
  <div class="pointer-events-none relative z-10 mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <p class="pointer-events-auto w-fit font-mono text-sm font-medium text-primary">{eyebrow}</p>
    <h1 class="pointer-events-auto mt-4 w-fit max-w-3xl !text-5xl sm:!text-6xl lg:!text-7xl">
      <slot />
    </h1>
    <p class="measure pointer-events-auto mt-6 w-fit text-lg leading-relaxed text-foreground-muted sm:text-xl">
      {subhead}
    </p>
    <div class="pointer-events-auto relative z-30 mt-10 flex w-fit flex-wrap gap-4">
      <Button
        href={(!primaryCta.disabled && primaryCta.href) || ""}
        size="lg"
        disabled={primaryCta.disabled}
      >
        {primaryCta.label}
      </Button>
      <Button
        href={(!secondaryCta.disabled && secondaryCta.href) || ""}
        variant="secondary"
        size="lg"
        disabled={secondaryCta.disabled}
      >
        {secondaryCta.label}
      </Button>
    </div>
  </div>
</section>

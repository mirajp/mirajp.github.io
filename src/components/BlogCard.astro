---
import { formatDate } from "../utils/readingTime";
import Tag from "./Tag.astro";

interface Props {
  slug: string;
  title: string;
  description: string;
  publishDate: Date;
  readingTime: string;
  tags: string[];
}

const { slug, title, description, publishDate, readingTime, tags } = Astro.props;
---

<article class="group border-b border-border py-8 first:pt-0 last:border-b-0">
  <a href={`/blog/${slug}/`} class="block rounded-sm">
    <div class="flex flex-wrap items-center gap-3 text-xs text-foreground-muted">
      <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime}</span>
    </div>

    <h3 class="mt-2 !text-2xl !font-semibold !leading-snug text-foreground group-hover:text-primary">
      {title}
    </h3>
    <p class="mt-2 text-[15px] leading-relaxed text-foreground-muted">{description}</p>

    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
      {tags.map((tag) => <li><Tag label={tag} /></li>)}
    </ul>
  </a>
</article>

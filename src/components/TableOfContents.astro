---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

// Only h2/h3 — an article-level ToC that also lists h4s gets noisy fast.
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav aria-label="Table of contents" class="rounded-lg border border-border bg-surface p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-foreground-muted">On this page</p>
      <ul class="mt-3 space-y-2 text-sm">
        {items.map((heading) => (
          <li class={heading.depth === 3 ? "pl-4" : ""}>
            <a href={`#${heading.slug}`} class="text-foreground-muted hover:text-primary">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

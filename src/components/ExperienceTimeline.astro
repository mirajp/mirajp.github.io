---
import type { ExperienceEntry } from "../data/experience";

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;
---

<ol class="relative">
  {
    entries.map((entry) => (
      <li class="relative border-l border-border py-8 pl-8 first:pt-0 last:border-transparent last:pb-0 print:break-inside-avoid">
        <span
          class="absolute -left-[7px] top-9 h-3.5 w-3.5 rounded-full border-2 border-background bg-primary"
          aria-hidden="true"
        />

        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="!text-xl !font-semibold text-foreground">
            {entry.title}
            <span class="font-normal text-foreground-muted"> · {entry.company}{entry.team ? `, ${entry.team}` : ""}</span>
          </h3>
          <p class="shrink-0 font-mono text-sm text-foreground-muted">
            {entry.start} – {entry.end}
          </p>
        </div>
        <p class="mt-0.5 text-sm text-foreground-muted">{entry.location}</p>

        <ul class="mt-4 space-y-2.5">
          {entry.bullets.map((bullet) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-foreground-muted">
              <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-foreground-muted" aria-hidden="true" />
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
